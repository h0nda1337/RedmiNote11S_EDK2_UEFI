  ArmMmuLib
  ArmSmcLib
  BaseLib
  BaseMemoryLib
  DebugLib
  PcdLib
  StackCheckLib
  HobLib
  PrePiLib
  PrePiHobListPointerLib
  MielFdtLib
  MielPlatformLib
  MielHandoffLib
  MielFrameBufferLib
  MielMemoryPlanLib

[Guids]
